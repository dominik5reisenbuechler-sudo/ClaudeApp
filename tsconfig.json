{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "//": "supabase/functions is Deno, not React Native. It has its own globals and its own module resolution, so type-checking it with the app's config only produces noise. It is checked by `supabase functions deploy`.",
  "exclude": ["node_modules", "dist", ".expo", "supabase/functions"]
}
