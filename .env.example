# Copy to `.env` and fill in. `.env` is git-ignored.
#
# Only EXPO_PUBLIC_* values are readable from the app bundle. They are, by
# definition, public — the anon key is safe to ship ONLY because Row Level
# Security is enabled on every table (see docs/DATABASE_SCHEMA.md).
#
# The service-role key must NEVER appear here or anywhere in the app. Anything
# needing it belongs in a Supabase Edge Function.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
